---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={guide.data.title} section="guides" description={guide.data.summary}>
  <article class="wrap guide">
    <header class="guide-head">
      <p class="eyebrow" style="color: var(--mustard-ink)">Guide</p>
      <h1>{guide.data.title}</h1>
      <p class="meta">
        Updated <time datetime={guide.data.updated.toISOString()}>{fmt(guide.data.updated)}</time>
        {guide.data.tags.map((t) => <span>#{t}</span>)}
      </p>
    </header>
    <div class="prose"><Content /></div>
    <p class="back"><a href="/guides/">← All guides</a></p>
  </article>
</Base>

<style>
  .guide {
    padding-top: 56px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .guide-head { display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(36px, 5vw, 52px); max-width: 760px; }
  .meta {
    margin: 0;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--ink-faint);
  }
  .back { margin: 0; font-weight: 600; }
</style>
