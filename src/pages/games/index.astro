---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Games" section="games" theme="night" description="Retro games rebuilt for the browser. No downloads, no accounts, no ads.">
  <section class="arcade-hero">
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
    </div>
    <div class="wrap arcade-copy">
      <p class="eyebrow" style="color: #5eeaf5">Insert coin</p>
      <h1>The Arcade</h1>
      <p class="lede">
        Retro games rebuilt for the browser. No downloads, no accounts, no ads — just the kind of
        thing that used to eat your afternoons.
      </p>
    </div>
    <div class="floor" aria-hidden="true"><i></i></div>
  </section>

  <section class="wrap cabinets">
    <div class="cab-head">
      <h2>Pick your cabinet</h2>
      <p>Best scores are saved on this device only.</p>
    </div>
    {
      games.length === 0 ? (
        <div class="soon">
          <p class="soon-title">The cabinets are being wheeled in.</p>
          <p>The first games are still in the workshop. Check back soon, or read about how they're being built in Writing.</p>
        </div>
      ) : (
        <div class="grid">
          {games.map((g) => (
            <a class="card cab" href={g.data.app}>
              <div class="cab-art" data-live={g.data.live ? `${g.data.app}?cabinet` : undefined}>
                {g.data.image && <img src={g.data.image} alt="" width="960" height="720" loading="lazy" decoding="async" />}
                {g.data.live && <span class="tube" aria-hidden="true"></span>}
              </div>
              <div class="cab-body">
                <div class="cab-row">
                  <p class="cab-name">{g.data.name}</p>
                  {g.data.tags[0] && <span class="pill">{g.data.tags[0]}</span>}
                </div>
                <p class="cab-desc">{g.data.summary}</p>
                <p class="cab-play">Play →</p>
              </div>
            </a>
          ))}
        </div>
      )
    }
    <div class="how">
      <div>
        <p class="how-title">Fan page: Command &amp; Conquer</p>
        <p>Red Alert 2 and Renegade, two games I still play online, and where to play them today.</p>
      </div>
      <a class="btn btn--ghost" href="/games/command-and-conquer/">Read the fan page</a>
    </div>
    <div class="how">
      <div>
        <p class="how-title">How these are made</p>
        <p>Each game is a self-contained page that runs in your browser. The write-up for each one — design choices, what was hard, what was fun — lives in Writing.</p>
      </div>
      <a class="btn btn--ghost" href="/writing/">Read the build notes</a>
    </div>
  </section>
</Base>

<script>
  // A live cabinet runs the game itself, but only while it is on screen, and never
  // for someone who has asked for less motion: they keep the still picture.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still && 'IntersectionObserver' in window) {
    const watch = new IntersectionObserver(entries => {
      for (const { target, isIntersecting } of entries) {
        const on = target.querySelector('iframe');
        if (isIntersecting && !on) {
          const screen = document.createElement('iframe');
          screen.src = target.dataset.live;
          screen.title = '';
          screen.tabIndex = -1;
          screen.setAttribute('aria-hidden', 'true');
          screen.addEventListener('load', () => target.classList.add('on'));
          target.insertBefore(screen, target.querySelector('.tube'));
        } else if (!isIntersecting && on) {
          on.remove();
          target.classList.remove('on');
        }
      }
    }, { rootMargin: '120px' });
    document.querySelectorAll('[data-live]').forEach(el => watch.observe(el));
  }
</script>

<style>
  /* ---- the hero: a striped sun going down over a neon grid that runs toward you ---- */
  .arcade-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #130b30 0%, #2a1060 55%, #6b1a66 100%);
  }
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sun {
    position: absolute;
    left: 68%;
    bottom: 110px;
    width: min(400px, 70vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: linear-gradient(180deg, #ffd66b 0%, #ff8a5b 45%, #ff3d9e 100%);
    /* horizontal bands, thinner toward the top, cut off below the horizon */
    -webkit-mask-image:
      linear-gradient(180deg, #000 0 40%, transparent 40%),
      repeating-linear-gradient(180deg, #000 0 24px, transparent 24px 32px);
    -webkit-mask-composite: source-over;
    mask-image:
      linear-gradient(180deg, #000 0 40%, transparent 40%),
      repeating-linear-gradient(180deg, #000 0 24px, transparent 24px 32px);
    mask-composite: add;
    filter: drop-shadow(0 0 40px rgba(255, 95, 184, 0.6));
  }
  .arcade-copy {
    position: relative;
    z-index: 2;
    padding-top: 96px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .arcade-hero h1 {
    font-size: clamp(48px, 8vw, 72px);
    color: #fff;
    text-shadow: 0 0 6px #fff, 0 0 18px #5eeaf5, 0 0 42px #ff5fb8, 0 0 80px #ff5fb8;
  }

  /* the floor: a flat grid tilted back under perspective, scrolling one cell every 1.8 s */
  .floor {
    position: relative;
    z-index: 1;
    height: 190px;
    perspective: 300px;
    perspective-origin: 50% 0;
    overflow: hidden;
    border-top: 2px solid #5eeaf5;
    box-shadow: 0 -8px 40px rgba(94, 234, 245, 0.5);
    background: #130b30;
  }
  .floor i {
    position: absolute;
    left: -60%;
    right: -60%;
    top: 0;
    height: 560px;
    transform: rotateX(74deg);
    transform-origin: 50% 0;
    background-image:
      linear-gradient(#5eeaf5 2px, transparent 2px),
      linear-gradient(90deg, #ff5fb8 2px, transparent 2px);
    background-size: 56px 56px;
    animation: floor-run 1.8s linear infinite;
  }
  .floor::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, #130b30 100%);
  }
  @keyframes floor-run {
    to { background-position: 0 56px, 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floor i { animation: none; }
  }
  @media (max-width: 800px) {
    .sun { left: 50%; bottom: 80px; opacity: 0.55; }
  }
  @media (max-width: 560px) {
    .sun { bottom: 60px; width: 70vw; }
    .floor { height: 140px; }
  }
  .lede {
    margin: 0;
    font-size: 19px;
    max-width: 560px;
    color: var(--ink-soft);
  }

  .cabinets {
    padding-top: 40px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cab-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cab-head h2 { font-size: 32px; color: #fff; }
  .cab-head p { margin: 0; font-size: 14px; color: var(--ink-faint); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }

  .cab { gap: 0; }
  .cab-art {
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, #2b1c6b, #0e0826);
    border-bottom: 3px solid #ff5fb8;
    overflow: hidden;
  }
  .cab-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A live cabinet: the running game, seen through the glass of a tube. Clicks go
     through it to the card. */
  .cab-art[data-live] { position: relative; overflow: hidden; background: #000; }
  .cab-art :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cab-art.on :global(iframe) { opacity: 1; animation: tube-hum 7s steps(1) infinite; }
  .tube {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: 7% / 9%;
    box-shadow: 0 0 0 12px #06040c, inset 0 0 44px 12px rgba(0, 0, 0, 0.72), inset 0 0 3px 1px rgba(255, 255, 255, 0.14);
    background:
      radial-gradient(ellipse 60% 34% at 26% 12%, rgba(255, 255, 255, 0.09), transparent 70%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0 1px, transparent 1px 3px);
  }
  /* the slow band of a tube's own refresh, rolling down the glass */
  .tube::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 26%;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.05), transparent);
    animation: tube-roll 8s linear infinite;
  }
  @keyframes tube-roll {
    from { top: -30%; }
    to { top: 104%; }
  }
  @keyframes tube-hum {
    0%, 91%, 93%, 100% { filter: brightness(1.08) saturate(1.2); }
    92% { filter: brightness(1.2) saturate(1.2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tube::after { animation: none; display: none; }
  }
  .cab-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 22px;
  }
  .cab-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .cab-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    color: #fff;
  }
  .pill {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: #ff5fb8;
    color: #130b30;
  }
  .cab-desc { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .cab-play { margin: 6px 0 0; font-size: 13px; font-weight: 600; color: #5eeaf5; }

  .soon {
    padding: 32px;
    border-radius: var(--radius);
    background: var(--paper-2);
    border: 1px dashed var(--line);
  }
  .soon p { margin: 0; color: var(--ink-muted); }
  .soon-title {
    font-family: var(--font-display);
    font-size: 22px;
    color: #fff !important;
    margin-bottom: 8px !important;
  }

  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 16px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper-2);
    border: 1px solid var(--line);
    align-items: center;
    justify-content: space-between;
  }
  .how > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1 1 400px;
  }
  .how p { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .how-title { font-family: var(--font-display); font-size: 20px !important; color: #fff !important; }
  .how .btn { white-space: nowrap; }
</style>
