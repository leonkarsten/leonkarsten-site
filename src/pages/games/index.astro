---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const games = (await getCollection('games')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Games" section="games" theme="night" description="Retro games rebuilt for the browser. No downloads, no accounts, no ads.">
  <section class="arcade-hero">
    <svg viewBox="0 0 1280 560" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#130b30" /><stop offset="1" stop-color="#4a1562" />
        </linearGradient>
        <linearGradient id="sun" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffd66b" /><stop offset="1" stop-color="#ff3d9e" />
        </linearGradient>
        <linearGradient id="gridfade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ff5fb8" stop-opacity="0" /><stop offset="1" stop-color="#ff5fb8" stop-opacity=".9" />
        </linearGradient>
        <clipPath id="sunclip">
          <rect x="440" y="120" width="400" height="18" /><rect x="440" y="150" width="400" height="22" />
          <rect x="440" y="184" width="400" height="26" /><rect x="440" y="222" width="400" height="32" />
          <rect x="440" y="266" width="400" height="40" /><rect x="440" y="318" width="400" height="80" />
        </clipPath>
      </defs>
      <rect width="1280" height="560" fill="url(#sky)" />
      <circle cx="640" cy="300" r="170" fill="url(#sun)" clip-path="url(#sunclip)" />
      <g stroke="url(#gridfade)" stroke-width="1.5" fill="none">
        <line x1="0" y1="400" x2="1280" y2="400" /><line x1="0" y1="420" x2="1280" y2="420" />
        <line x1="0" y1="446" x2="1280" y2="446" /><line x1="0" y1="480" x2="1280" y2="480" />
        <line x1="0" y1="522" x2="1280" y2="522" />
        <line x1="640" y1="400" x2="640" y2="560" /><line x1="560" y1="400" x2="440" y2="560" />
        <line x1="480" y1="400" x2="240" y2="560" /><line x1="400" y1="400" x2="40" y2="560" />
        <line x1="320" y1="400" x2="-160" y2="560" /><line x1="720" y1="400" x2="840" y2="560" />
        <line x1="800" y1="400" x2="1040" y2="560" /><line x1="880" y1="400" x2="1240" y2="560" />
        <line x1="960" y1="400" x2="1440" y2="560" />
      </g>
      <rect y="396" width="1280" height="4" fill="#5eeaf5" opacity=".8" />
    </svg>
    <div class="wrap arcade-copy">
      <p class="eyebrow" style="color: #5eeaf5">Insert coin</p>
      <h1>The Arcade</h1>
      <p class="lede">
        Retro games rebuilt for the browser. No downloads, no accounts, no ads — just the kind of
        thing that used to eat your afternoons.
      </p>
    </div>
  </section>

  <section class="wrap cabinets">
    <div class="cab-head">
      <h2>Pick your cabinet</h2>
      <p>Best scores are saved on this device only.</p>
    </div>
    {
      games.length === 0 ? (
        <div class="soon">
          <p class="soon-title">The cabinets are being wheeled in.</p>
          <p>The first games are still in the workshop. Check back soon, or read about how they're being built in Writing.</p>
        </div>
      ) : (
        <div class="grid">
          {games.map((g) => (
            <a class="card cab" href={g.data.app}>
              <div class="cab-art" />
              <div class="cab-body">
                <div class="cab-row">
                  <p class="cab-name">{g.data.name}</p>
                  {g.data.tags[0] && <span class="pill">{g.data.tags[0]}</span>}
                </div>
                <p class="cab-desc">{g.data.summary}</p>
                <p class="cab-play">Play →</p>
              </div>
            </a>
          ))}
        </div>
      )
    }
    <div class="how">
      <div>
        <p class="how-title">How these are made</p>
        <p>Each game is a self-contained page built with Claude Code. The write-up for each one — design choices, what was hard, what was fun — lives in Writing.</p>
      </div>
      <a class="btn btn--ghost" href="/writing/">Read the build notes</a>
    </div>
  </section>
</Base>

<style>
  .arcade-hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .arcade-hero > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .arcade-copy {
    position: relative;
    z-index: 1;
    padding-top: 96px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .arcade-hero h1 {
    font-size: clamp(48px, 8vw, 72px);
    color: #fff;
    text-shadow: 0 0 18px rgba(255, 95, 184, 0.55);
  }
  .lede {
    margin: 0;
    font-size: 19px;
    max-width: 560px;
    color: var(--ink-soft);
  }

  .cabinets {
    padding-top: 40px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cab-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cab-head h2 { font-size: 32px; color: #fff; }
  .cab-head p { margin: 0; font-size: 14px; color: var(--ink-faint); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }

  .cab { gap: 0; }
  .cab-art {
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, #2b1c6b, #0e0826);
    border-bottom: 3px solid #ff5fb8;
  }
  .cab-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 22px;
  }
  .cab-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .cab-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    color: #fff;
  }
  .pill {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: #ff5fb8;
    color: #130b30;
  }
  .cab-desc { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .cab-play { margin: 6px 0 0; font-size: 13px; font-weight: 600; color: #5eeaf5; }

  .soon {
    padding: 32px;
    border-radius: var(--radius);
    background: var(--paper-2);
    border: 1px dashed var(--line);
  }
  .soon p { margin: 0; color: var(--ink-muted); }
  .soon-title {
    font-family: var(--font-display);
    font-size: 22px;
    color: #fff !important;
    margin-bottom: 8px !important;
  }

  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 16px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--paper-2);
    border: 1px solid var(--line);
    align-items: center;
    justify-content: space-between;
  }
  .how > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1 1 400px;
  }
  .how p { margin: 0; font-size: 14px; color: var(--ink-muted); }
  .how-title { font-family: var(--font-display); font-size: 20px !important; color: #fff !important; }
  .how .btn { white-space: nowrap; }
</style>
