---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={post.data.title} section="writing" description={post.data.summary}>
  <article class="wrap post">
    <header class="post-head">
      <p class="eyebrow" style="color: var(--c-writing)">Writing</p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.tags.map((t) => <span>#{t}</span>)}
      </p>
    </header>
    <div class="prose"><Content /></div>
    <p class="back"><a href="/writing/">← All writing</a></p>
  </article>
</Base>

<style>
  .post {
    padding-top: 56px;
    padding-bottom: 72px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .post-head { display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(36px, 5vw, 52px); max-width: 760px; }
  .meta {
    margin: 0;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--ink-faint);
  }
  .back { margin: 0; font-weight: 600; }
</style>
