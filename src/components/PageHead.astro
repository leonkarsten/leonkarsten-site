---
interface Props {
  eyebrow: string;
  title: string;
  color?: string;
}
const { eyebrow, title, color = 'var(--red)' } = Astro.props;
---

<section class="wrap page-head">
  <p class="eyebrow" style={`color: ${color}`}>{eyebrow}</p>
  <h1>{title}</h1>
  <p class="lede"><slot /></p>
</section>

<style>
  .page-head {
    padding-top: 56px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 { font-size: clamp(36px, 5vw, 52px); max-width: 720px; }
  .lede {
    margin: 0;
    font-size: 18px;
    max-width: 640px;
    color: var(--ink-soft);
  }
  .lede:empty { display: none; }
</style>
