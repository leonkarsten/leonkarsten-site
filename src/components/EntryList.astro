---
interface Entry {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  datePrefix?: string;
}
interface Props {
  entries: Entry[];
  empty: string;
}
const { entries, empty } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---

{
  entries.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="entries">
      {entries.map((e) => (
        <li>
          <a href={e.href} class="entry">
            <p class="date">{e.datePrefix}{fmt(e.date)}</p>
            <p class="title">{e.title}</p>
            <p class="summary">{e.summary}</p>
            {e.tags.length > 0 && (
              <p class="tags">{e.tags.map((t) => <span>#{t}</span>)}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .empty {
    margin: 0 0 72px;
    color: var(--ink-muted);
  }
  .entries {
    list-style: none;
    margin: 0 0 72px;
    padding: 0;
    display: flex;
    flex-direction: column;
    max-width: 760px;
  }
  .entries li {
    border-top: 1px solid var(--line);
  }
  .entries li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 4px;
    color: var(--ink);
  }
  .entry:hover .title { color: var(--red); }
  .entry p { margin: 0; }
  .date { font-size: 13px; color: var(--ink-faint); }
  .title {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--navy);
  }
  .summary { color: var(--ink-soft); }
  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--ink-faint);
  }
</style>
