---
interface Props {
  current?: string;
}
const { current } = Astro.props;

const items = [
  { href: '/tools/', label: 'Tools', key: 'tools' },
  { href: '/games/', label: 'Games', key: 'games' },
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/guides/', label: 'Guides', key: 'guides' },
  { href: '/about/', label: 'About', key: 'about' },
];
---

<header class="wrap site-header">
  <nav class="nav" aria-label="Main">
    <a href="/" class="brand">
      <span class="mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span>leon karsten</span>
    </a>
    <ul class="links">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="stripe-rule stripe-rule--rounded" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    z-index: 2;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .brand:hover {
    color: var(--ink);
  }
  .mark {
    display: flex;
    gap: 3px;
    height: 28px;
    align-items: flex-end;
  }
  .mark span {
    width: 6px;
    border-radius: 2px;
  }
  .mark span:nth-child(1) { height: 28px; background: var(--navy); }
  .mark span:nth-child(2) { height: 22px; background: var(--teal); }
  .mark span:nth-child(3) { height: 16px; background: var(--orange); }
  .mark span:nth-child(4) { height: 10px; background: var(--red); }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .links a {
    display: inline-block;
    padding: 10px 4px;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    border-bottom: 2px solid transparent;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--red);
  }
  .links a[aria-current='page'] {
    border-bottom-color: var(--red);
  }
</style>
